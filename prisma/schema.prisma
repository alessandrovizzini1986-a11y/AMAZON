// FleetDSP — schema dati gestionale flotta DSP Amazon
// Vincoli chiave:
//  - targa unica tra i veicoli non dismessi (indice parziale, vedi migrazione)
//  - pratica sostitutivo unica per (veicolo, data ingresso officina)
//  - ogni mutazione applicativa scrive su AuditLog

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  ADMIN
  RESP_MEZZI
  DRIVER
  CONTROLLO // controlli presenze (stagista): solo modulo Presenze e vademecum
}

enum VehicleStatus {
  ATTIVO
  IN_OFFICINA
  SOSTITUTIVO
  UFFICIO // mezzo ad uso ufficio/amministrativo, non in flotta operativa
  DISMESSO
}

enum ContractType {
  MT // medio termine
  LT // lungo termine
  BT // breve termine / noleggio a breve
  SOST // contratto di sostituzione temporanea
  UFFICIO
}

enum FuelType {
  DIESEL
  DIESEL_HVO // compatibile EN 15940
  BENZINA
  ELETTRICO
  METANO
  GPL
  IBRIDO
}

enum ServiceType {
  TAGLIANDO
  REVISIONE
  RIPARAZIONE
  GOMME
  CARROZZERIA
  ALTRO
}

enum FineStatus {
  DA_NOTIFICARE
  NOTIFICATA
  PAGATA
  RICORSO
  ANNULLATA
}

enum AppealStatus {
  NESSUNO
  IN_PREPARAZIONE
  PRESENTATO
  ACCOLTO
  RESPINTO
}

enum ChargebackStatus {
  NON_PREVISTO
  DA_ADDEBITARE
  ADDEBITATO
  CONTESTATO
  SALDATO
}

enum ReplacementReason {
  INCIDENTE
  GUASTO
  MANUTENZIONE
}

enum PracticeStatus {
  APERTA
  INVIATA
  CONFERMATA
  CONTESTATA
  CHIUSA
}

enum TransferStatus {
  RICHIESTO
  APPROVATO
  RIFIUTATO
  COMPLETATO
}

enum LiableParty {
  DRIVER
  TERZI
  IGNOTO
}

enum ImportStatus {
  COMPLETATO
  PARZIALE
  FALLITO
}

// ---------- Anagrafiche ----------

model Station {
  id        String   @id @default(cuid())
  code      String   @unique // es. DML1
  name      String
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  users            User[]
  vehicles         Vehicle[]
  stationHistory   VehicleStationHistory[] @relation("historyStation")
  assignments      Assignment[]
  transfersFrom    StationTransfer[]       @relation("transferFrom")
  transfersTo      StationTransfer[]       @relation("transferTo")
  tollTransactions TollTransaction[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role
  stationId    String? // null per ADMIN cluster-wide
  station      Station? @relation(fields: [stationId], references: [id])
  licenseNo    String? // patente, per multe con decurtazione punti
  phone        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  assignments        Assignment[]
  finesAssigned      Fine[]            @relation("fineDriver")
  damagesReported    Damage[]          @relation("damageReporter")
  auditLogs          AuditLog[]
  importJobs         ImportJob[]
  transfersRequested StationTransfer[] @relation("transferRequestedBy")
  transfersApproved  StationTransfer[] @relation("transferApprovedBy")
}

model Vehicle {
  id                  String        @id @default(cuid())
  targa               String // unicità parziale su stato != DISMESSO via migrazione SQL
  modello             String
  allestimento        String?
  alimentazione       FuelType
  hvoCompatibile      Boolean       @default(false) // EN 15940
  immatricolazione    DateTime? // data di prima immatricolazione, se nota (distinta dall'inizio contratto)
  stationId           String
  station             Station       @relation(fields: [stationId], references: [id])
  stato               VehicleStatus @default(ATTIVO)
  kmAttuali           Int           @default(0)
  canoneMese          Decimal?      @db.Decimal(10, 2) // canone mensile — configurabile, mai hardcoded
  franchigiaDanni     Decimal?      @db.Decimal(10, 2) // franchigia danni da contratto di noleggio/leasing
  leasingCompany      String? // ALD / ALD MT / Europcar / Hertz / Arval / Noleggiare / Avis / Torental / Vem...
  contrattoLeasingNo  String? // N° RA
  tipoContratto       ContractType? // MT / LT / BT / SOST / UFFICIO
  contrattoDataInizio DateTime?
  contrattoDataFine   DateTime?
  note                String? // note operative libere (spostamenti tra stazioni, riferimenti mezzo sostituito, ecc.)

  // scadenzario (doppia soglia: km e data — alert sulla prima che scatta)
  prossimoTagliandoData DateTime?
  prossimoTagliandoKm   Int?
  prossimaRevisione     DateTime? // scadenza legale, distinta dal tagliando

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stationHistory   VehicleStationHistory[]
  serviceRecords   ServiceRecord[]
  fines            Fine[]
  assignments      Assignment[]
  transfers        StationTransfer[]
  replacementCases ReplacementCase[]       @relation("caseVehicle")
  replacementFor   ReplacementCase[]       @relation("caseReplacementVehicle")
  damages          Damage[]
  fuelCards        FuelCard[]
}

model VehicleStationHistory {
  id        String    @id @default(cuid())
  vehicleId String
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id])
  stationId String
  station   Station   @relation("historyStation", fields: [stationId], references: [id])
  fromDate  DateTime
  toDate    DateTime?
  note      String?

  @@index([vehicleId, fromDate])
}

// ---------- Manutenzione ----------

model ServiceRecord {
  id           String      @id @default(cuid())
  vehicleId    String
  vehicle      Vehicle     @relation(fields: [vehicleId], references: [id])
  tipo         ServiceType
  officina     String
  data         DateTime
  kmIntervento Int
  costo        Decimal     @db.Decimal(10, 2)
  descrizione  String?
  createdAt    DateTime    @default(now())

  @@index([vehicleId, data])
}

// ---------- Multe ----------

model Fine {
  id                String     @id @default(cuid())
  vehicleId         String
  vehicle           Vehicle    @relation(fields: [vehicleId], references: [id])
  verbaleNo         String?
  dataOraInfrazione DateTime
  luogo             String
  tipoViolazione    String
  importo           Decimal    @db.Decimal(10, 2)
  puntiPatente      Int        @default(0)
  stato             FineStatus @default(DA_NOTIFICARE)
  dataNotifica      DateTime?

  // assegnazione conducente: da log movimentazione, mai "a caso".
  // se non c'è check-in/out coerente il campo resta null = "da assegnare"
  driverId          String?
  driver            User?   @relation("fineDriver", fields: [driverId], references: [id])
  assegnazioneFonte String? // es. "check-in 2026-03-12 DML2" oppure "manuale: <motivo>"

  // ricorso
  statoRicorso    AppealStatus @default(NESSUNO)
  scadenzaRicorso DateTime? // 60gg prefetto / 30gg giudice di pace, calcolata da config
  noteRicorso     String?

  // riaddebito al driver secondo policy — parte "da addebitare" (in attesa di
  // assegnazione conducente); se non assegnata entro la soglia configurata
  // (fine.riaddebito.scadenzaGiorni) diventa automaticamente "non previsto"
  // (a carico azienda) — vedi domain/fines.ts riaddebitoEffettivo()
  riaddebito        ChargebackStatus @default(DA_ADDEBITARE)
  importoRiaddebito Decimal?         @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId, dataOraInfrazione])
  @@index([driverId])
  @@index([stato])
}

// ---------- Movimentazione ----------

model Assignment {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  driverId  String
  driver    User     @relation(fields: [driverId], references: [id])
  stationId String
  station   Station  @relation(fields: [stationId], references: [id])

  checkInAt     DateTime?
  checkInKm     Int?
  checkInFoto   String? // path/URL foto stato mezzo
  checkInNote   String?
  checkOutAt    DateTime?
  checkOutKm    Int?
  checkOutFoto  String?
  checkOutNote  String?
  danniRilevati String?

  createdAt DateTime @default(now())

  @@unique([vehicleId, date]) // un mezzo non può essere assegnato due volte lo stesso giorno
  @@index([driverId, date])
  @@index([stationId, date])
}

model StationTransfer {
  id            String         @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle        @relation(fields: [vehicleId], references: [id])
  fromStationId String
  fromStation   Station        @relation("transferFrom", fields: [fromStationId], references: [id])
  toStationId   String
  toStation     Station        @relation("transferTo", fields: [toStationId], references: [id])
  status        TransferStatus @default(RICHIESTO)
  requestedById String
  requestedBy   User           @relation("transferRequestedBy", fields: [requestedById], references: [id])
  approvedById  String?
  approvedBy    User?          @relation("transferApprovedBy", fields: [approvedById], references: [id])
  motivo        String?
  requestedAt   DateTime       @default(now())
  resolvedAt    DateTime?

  @@index([vehicleId])
  @@index([status])
}

// ---------- Mezzi sostitutivi / storno canone ----------

model ReplacementCase {
  id                       String            @id @default(cuid())
  vehicleId                String
  vehicle                  Vehicle           @relation("caseVehicle", fields: [vehicleId], references: [id])
  motivo                   ReplacementReason
  dataIngressoOfficina     DateTime          @db.Date
  centroConvenzionato      String
  replacementVehicleId     String?
  replacementVehicle       Vehicle?          @relation("caseReplacementVehicle", fields: [replacementVehicleId], references: [id])
  dataRicezioneSostitutivo DateTime?         @db.Date
  dataRientroOriginale     DateTime?         @db.Date

  stato PracticeStatus @default(APERTA)

  // lock/versionamento: al passaggio a INVIATA il canone viene fotografato
  // e la pratica non è più modificabile (solo Admin con audit trail)
  inviataAt          DateTime?
  canoneMeseSnapshot Decimal?  @db.Decimal(10, 2) // canone mensile fotografato all'invio
  giorniScoperti     Int? // congelati all'invio
  importoStorno      Decimal?  @db.Decimal(10, 2)

  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // un solo storno per (targa, data ingresso officina): mai doppia richiesta
  @@unique([vehicleId, dataIngressoOfficina])
  @@index([stato])
}

// ---------- Danni / sinistri ----------

model Damage {
  id                  String      @id @default(cuid())
  vehicleId           String
  vehicle             Vehicle     @relation(fields: [vehicleId], references: [id])
  tipo                String
  data                DateTime
  descrizione         String?
  fotoUrl             String?
  centroRiparazione   String?
  responsabilita      LiableParty @default(IGNOTO)
  reporterId          String?
  reporter            User?       @relation("damageReporter", fields: [reporterId], references: [id])
  praticaAssicurativa String? // riferimento sinistro assicurazione
  costoStimato        Decimal?    @db.Decimal(10, 2)
  chiuso              Boolean     @default(false)
  createdAt           DateTime    @default(now())

  @@index([vehicleId, data])
}

// ---------- Fuel & Telepass ----------

model FuelCard {
  id        String   @id @default(cuid())
  pan       String   @unique // identificativo carta Q8 — chiave di riconciliazione, NON la targa
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])
  attiva    Boolean  @default(true)

  transactions FuelTransaction[]
}

model FuelTransaction {
  id           String     @id @default(cuid())
  fuelCardId   String
  fuelCard     FuelCard   @relation(fields: [fuelCardId], references: [id])
  data         DateTime
  litri        Decimal    @db.Decimal(10, 2)
  importo      Decimal    @db.Decimal(10, 2)
  puntoVendita String?
  prodotto     String? // DIESEL / HVO / ...
  importJobId  String?
  importJob    ImportJob? @relation(fields: [importJobId], references: [id])

  @@index([fuelCardId, data])
}

model TollTransaction {
  id          String     @id @default(cuid())
  stationId   String
  station     Station    @relation(fields: [stationId], references: [id])
  deviceCode  String? // codice apparato Telepass
  targa       String?
  data        DateTime
  tratta      String?
  importo     Decimal    @db.Decimal(10, 2)
  importJobId String?
  importJob   ImportJob? @relation(fields: [importJobId], references: [id])

  @@index([stationId, data])
}

// ---------- Config & controllo ----------

// Zero hardcoded: soglie alert, coefficienti consumo, giorni ricorso, ecc.
model AppConfig {
  key         String   @id
  value       String // serializzato; type indica il parsing
  type        String   @default("string") // string | number | number[] | boolean
  description String
  updatedAt   DateTime @updatedAt
  updatedById String?
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String // es. fine.create, replacement.send
  entity    String
  entityId  String?
  meta      Json? // before/after o payload sintetico
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model ImportJob {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  entity       String // vehicles | drivers | services | fines | leases | movements | replacements | fuel | tolls
  fileName     String
  status       ImportStatus
  totalRows    Int
  importedRows Int
  skippedRows  Int
  errorLog     Json? // [{row, error}]
  createdAt    DateTime     @default(now())

  fuelTransactions FuelTransaction[]
  tollTransactions TollTransaction[]

  @@index([createdAt])
}

// Ordini di veicoli nuovi presso il noleggiatore (es. Ayvens per l'appalto GLS),
// caricati dall'export "Lista Ordini" del fornitore. Chiave: numero ordine.
model FleetOrder {
  id               String    @id @default(cuid())
  fornitore        String // es. AYVENS
  appalto          String // es. GLS
  refOrdine        String
  targa            String?
  statoFornitore   String // stato così come scritto dal fornitore (Vettura Prodotta, Da ritirare, …)
  previstaConsegna DateTime?
  dataRitiro       DateTime? // data di ritiro concordata/avvenuta
  marchio          String?
  modello          String?
  puntoRitiro      String?
  indirizzoRitiro  String?
  telaio           String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([fornitore, refOrdine])
  @@index([appalto])
}

// Centri autorizzati Ayvens per veicoli commerciali (file "Lista Centri" di Ayvens).
// Una riga per centro e marchio, come nel file; ogni caricamento sostituisce l'elenco intero.
model ServiceCenter {
  id             String   @id @default(cuid())
  ragioneSociale String
  regione        String
  localita       String
  provincia      String
  indirizzo      String
  officina       Boolean
  carrozzeria    Boolean
  rete           String // marchio della rete ufficiale oppure "Nessuno"
  tuttiBrand     Boolean
  transit        Boolean // Transit Center (Ford)
  fonte          String // nome del file caricato
  createdAt      DateTime @default(now())

  @@index([regione, provincia])
}

// ---------- Modulo presenze (controlli tracking vs Amazon / Zucchetti) ----------
// Sul server solo metadati e risultati: i file originali restano sul PC.

// File caricati nell'archivio (un CSV Amazon unito genera una riga per station e giorno)
model PresenzeFile {
  id           String   @id @default(cuid())
  tipo         String // TRACKING_SIC | TRACKING_STD | FLEX_CSV | ZUCCHETTI
  station      String
  anno         Int
  mese         Int
  giorno       Int      @default(0) // solo FLEX_CSV (1..31), altrimenti 0
  nomeFile     String
  hashSha256   String
  righe        Int
  caricatoDaId String
  caricatoDa   String // nome di chi l'ha caricato
  caricatoIl   DateTime @default(now())

  @@unique([tipo, hashSha256, station, anno, mese, giorno])
  @@index([anno, mese])
}

// Esecuzione salvata di un controllo
model PresenzeRun {
  id            String              @id @default(cuid())
  tipo          String // SETTIMANALE | FINE_MESE
  station       String? // null = tutte
  periodoDa     DateTime
  periodoA      DateTime
  eseguitoDaId  String
  eseguitoDa    String
  eseguitoIl    DateTime            @default(now())
  riepilogoJson Json
  nAlert        Int
  risultati     PresenzeRisultato[]

  @@index([tipo, eseguitoIl])
}

// Una riga per driver e categoria di anomalia; la stagista ne segna l'esito dopo la risposta Ops
model PresenzeRisultato {
  id           String      @id @default(cuid())
  runId        String
  run          PresenzeRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  station      String
  tipo         String // SIC | STD | STD+SIC | AMAZON
  driver       String
  driverId     String
  categoria    String // +1 | -1 | H | A | DELTA | NON_ABBINATO | 6+DOM | CONSECUTIVI
  giorni       Json // elenco giorni (AAAA-MM-GG) con dettaglio
  oreTracking  Float       @default(0)
  trasferte    Int         @default(0)
  rotte        Int         @default(0)
  nota         String      @default("")
  esitoOps     String      @default("aperto") // aperto | chiuso | giustificato
  notaOps      String?
  aggiornatoIl DateTime?

  @@index([runId])
}

// Dispatcher: esclusi da ogni alert del controllo settimanale (modificabili da ADMIN)
model PresenzeDispatcher {
  id        String   @id @default(cuid())
  cognome   String
  nome      String
  station   String? // null = qualsiasi station
  attivo    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([cognome, nome])
}

// Codici della riga RIPOSO (o dei commenti) che giustificano il giorno senza alert
model PresenzeGiustificativo {
  codice      String  @id
  descrizione String  @default("")
  attivo      Boolean @default(true)
}

// Referente Ops per station: il nome da salutare nei messaggi Teams ("Ciao <nome>")
model PresenzeReferente {
  station String @id
  nome    String
}

// ---------- Modulo Telepass e carburante ----------
// Sul server solo anagrafiche, metadati e totali: i file originali restano sul PC.

// Mappa Telepass (foglio TELEPASS FINALE di TBusiness_carica_veicoli.xlsx)
model TelepassDispositivo {
  codice       String   @id // codice dispositivo
  station      String
  targa        String? // AREA C
  progetto     String?
  check        String? // Attivo | Bloccato | Disattivo
  note         String?
  nonPiuInFile Boolean  @default(false) // presente in tabella ma assente dall'ultimo file importato
  aggiornatoIl DateTime @updatedAt
  aggiornatoDa String?

  @@index([station])
}

// Censimento fuel card Q8 (foglio Carte Q8 Flotte). Nome diverso da FuelCard,
// che esiste già (carte legate ai veicoli per le FuelTransaction).
model CartaCarburante {
  pan            String    @id
  numeroCarta    String?
  identificativo String? // Nominativo driver: AMZxxx / GLSxxx
  targa          String?
  bloccata       String?
  dataBlocco     DateTime?
  centroCosto    String?
  appalto        String? // AMZ | GLS
  ds             String? // vuoto o "Da verificare" = carta non attribuita
  note           String?
  ordine         Int       @default(0) // riga nel file: per l'abbinamento per Identificativo vince la prima carta
  nonPiuInFile   Boolean   @default(false)
  aggiornatoIl   DateTime  @updatedAt
  aggiornatoDa   String?

  @@index([identificativo])
}

// Storico degli import delle anagrafiche
model AnagraficaImport {
  id         String   @id @default(cuid())
  tipo       String // TELEPASS | FUELCARD
  nomeFile   String
  hashSha256 String
  righe      Int
  nuovi      Int
  aggiornati Int
  invariati  Int
  spariti    Int
  eseguitoDa String
  eseguitoIl DateTime @default(now())

  @@index([tipo, eseguitoIl])
}

// Elaborazione mensile Telepass (metadati + totali station × settimana)
model TelepassRun {
  id           String   @id @default(cuid())
  anno         Int
  mese         Int
  nomeFile     String // file CSV di partenza
  hashSha256   String
  righe        Int
  fuoriMese    Int
  nonMappati   Int // dispositivi
  ricondotti   Int // dispositivi con STATION non standard
  totale       Float
  totaliJson   Json // { station: { settimana: importo } }
  anomalieJson Json
  eseguitoDa   String
  eseguitoIl   DateTime @default(now())

  @@index([anno, mese])
}

// Elaborazione mensile Q8
model Q8Run {
  id                String   @id @default(cuid())
  anno              Int
  mese              Int
  nomeFile          String
  hashSha256        String
  righeExport       Int
  tenute            Int
  scartate          Int
  nonCensite        Int // carte
  perIdentificativo Int // carte abbinate per Identificativo (PAN riemesso)
  totale            Float
  totaliJson        Json
  anomalieJson      Json
  eseguitoDa        String
  eseguitoIl        DateTime @default(now())

  @@index([anno, mese])
}

// ---------- Modulo Fatture Amazon ----------
// I PDF e il file AGGREGATO restano sul PC: sul server solo fatture, righe estratte e forecast.

// Una fattura (o nota di credito) Amazon, da PDF o dallo storico del file AGGREGATO
model AmazonInvoice {
  id                   String              @id @default(cuid())
  numero               String              @unique // INV-IT3JDBF-0002543 (maiuscolo, trim, NV- → INV-)
  ds                   String // DER1 … DVN6
  tipo                 String // Fattura | Nota di credito
  dataFattura          DateTime
  periodoDa            DateTime
  periodoA             DateTime
  importoDovuto        Decimal             @db.Decimal(12, 2)
  sommaTotale          Decimal             @db.Decimal(12, 2)
  sommaAvere           Decimal             @db.Decimal(12, 2)
  nRighe               Int
  rifNotaCredito       String?
  pdfNome              String?
  pdfSha256            String?
  fonte                String // PDF | AGGREGATO
  esportataIl          DateTime?
  esportataDaId        String?
  presenteInFatt2026Il DateTime?
  righe                AmazonInvoiceLine[]
  createdAt            DateTime            @default(now())

  @@index([ds, periodoDa])
}

model AmazonInvoiceLine {
  id          String        @id @default(cuid())
  invoiceId   String
  invoice     AmazonInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  ds          String
  data        DateTime
  descrizione String
  quantita    Int
  prezzo      Decimal       @db.Decimal(12, 4)
  tasse       String // VAT 22
  rateoIva    Decimal       @db.Decimal(5, 4)
  importoIva  Decimal       @db.Decimal(12, 2)
  totale      Decimal       @db.Decimal(12, 2)
  avere       Decimal       @db.Decimal(12, 2) // netto = totale − importoIva
  microarea   String?
  macroarea   String?
  week        Int // settimana Amazon (dom–sab)
  mese        Int
  anno        Int
  classe      String // ND_STANDARD, SD_A, EXTRA_CARBURANTE, …
  chiave      String        @unique // numero|data|descrizione|quantità|avere|progressivo: impedisce i doppioni dello storico

  @@index([invoiceId])
  @@index([ds, data])
  @@index([anno, mese])
  @@index([anno, week])
  @@index([classe])
}

// File di forecast Amazon (PROF_<wk>_next / _same): per station, data e classe vale l'ultimo caricato
model ForecastFile {
  id           String          @id @default(cuid())
  nome         String
  linea        String // ND | SD
  sha256       String          @unique
  caricatoIl   DateTime        @default(now())
  caricatoDaId String?
  righe        ForecastRoute[]
}

model ForecastRoute {
  id          String       @id @default(cuid())
  fileId      String
  file        ForecastFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  week        Int
  data        DateTime
  station     String
  cycle       String
  serviceType String
  routes      Int
  classe      String

  @@index([station, data])
  @@index([week])
  @@index([fileId])
}

// Mappa service_type_scheduling (+ cycle, + station) → classe, modificabile da ADMIN ("*" = qualsiasi)
model ForecastClasseMap {
  id          String @id @default(cuid())
  serviceType String
  cycle       String @default("*")
  station     String @default("*")
  classe      String

  @@unique([serviceType, cycle, station])
}

// Mapping descrizione → MACROAREA / MICROAREA (opzione "precompilate" dell'export)
model MacroareaMap {
  descrizione String @id
  macroarea   String
  microarea   String
}

// ───────────── Costi del personale (fine mese) ─────────────

// Anagrafica CDL (HR, foglio "SIC Amazon TR"): ogni upload è una nuova versione per mese
model AnagraficaCDL {
  id                   String   @id @default(cuid())
  meseVersione         String // AAAA-MM
  cf                   String
  cognome              String
  nome                 String
  station              String
  contratto            String
  pctPt                Decimal? @db.Decimal(8, 4)
  hSettim              Decimal? @db.Decimal(8, 2)
  ggLavorativi         Decimal? @db.Decimal(8, 2)
  tipologiaPt          String
  rlm                  Decimal? @db.Decimal(16, 6)
  edr                  Decimal? @db.Decimal(16, 6)
  cdl                  Decimal  @db.Decimal(16, 6)
  savingFeGg           Decimal? @db.Decimal(16, 6)
  savingRolH           Decimal? @db.Decimal(16, 6)
  savingExfH           Decimal? @db.Decimal(16, 6)
  costoFestNonGodutaGg Decimal? @db.Decimal(16, 6)
  straoForfait         Decimal? @db.Decimal(16, 6)
  caricatoIl           DateTime @default(now())
  caricatoDa           String?

  @@unique([meseVersione, cf])
  @@index([cf])
}

// Tariffe per data (trasferta, extra domenica): vale l'ultima con validaDal ≤ data
model Tariffa {
  id        String   @id @default(cuid())
  voce      String
  validaDal DateTime @db.Date
  valore    Decimal  @db.Decimal(12, 4)
  fonte     String?

  @@unique([voce, validaDal])
}

// Coefficienti SIC/STD con storico (ricalcolati dal consuntivo)
model Parametro {
  id        String   @id @default(cuid())
  chiave    String
  validaDal DateTime @db.Date
  valore    Decimal  @db.Decimal(14, 6)
  fonte     String?
  note      String?

  @@unique([chiave, validaDal])
}

// Festivi: nazionali (station = TUTTE) e patroni
model Festivo {
  id          String   @id @default(cuid())
  data        DateTime @db.Date
  descrizione String
  station     String   @default("TUTTE")

  @@unique([data, station])
}

// Righe ADIT (CDC 5569, senza Sacchetti) per mese di fattura
model AditRiga {
  id             String  @id @default(cuid())
  meseFattura    String // AAAA-MM
  meseCompetenza String
  station        String
  cf             String
  cognome        String
  nome           String
  voceAdit       String
  voce           String // STD, MAGG50, STR30, STR65, SUPP18, FESTIVITA, FERIE_PERM_GOD, CARENZA, TRASFERTA, ALTRO…
  quantita       Decimal @db.Decimal(12, 2)
  costo          Decimal @db.Decimal(14, 2)
  residuo        Boolean @default(false)

  @@index([meseFattura, station])
}

// Righe payroll "Costi del personale PS" (CDC 5569, conti 6*)
model PayrollRiga {
  id          String  @id @default(cuid())
  mesePaga    String // AAAA-MM
  matr        String
  dipe        String
  station     String?
  cod1        String
  cod2        String
  descrizione String
  conto       String
  importo     Decimal @db.Decimal(14, 2)
  componente  String
  istituto    String?

  @@index([mesePaga, station])
}

// Stima salvata: righe per station × voce
model StimaCosti {
  id                 String   @id @default(cuid())
  mese               String // AAAA-MM (competenza M)
  popolazione        String // STD | SIC
  station            String
  voce               String
  quantita           Decimal? @db.Decimal(14, 2)
  tariffa            Decimal? @db.Decimal(14, 4)
  importo            Decimal  @db.Decimal(14, 2)
  versioneAnagrafica String?
  versioneParametri  String?
  creataIl           DateTime @default(now())
  creataDa           String?

  @@index([mese, popolazione])
}

model Riconciliazione {
  id          String   @id @default(cuid())
  mese        String
  popolazione String
  station     String
  voce        String
  stima       Decimal  @db.Decimal(14, 2)
  consuntivo  Decimal  @db.Decimal(14, 2)
  delta       Decimal  @db.Decimal(14, 2)
  nota        String?
  creataIl    DateTime @default(now())

  @@index([mese, popolazione])
}

// ───────────── MOG (monte ore garantito somministrati STD) ─────────────

// Righe del file ADECCO_PS (foglio PS): una versione per data di chiusura payroll
model MogContratto {
  id                         String    @id @default(cuid())
  versione                   String // AAAA-MM-GG = data chiusura payroll del file
  cf                         String
  nome                       String
  cognome                    String
  sito                       String
  station                    String?
  dataInizio                 DateTime? @db.Date
  dataFine                   DateTime? @db.Date
  pctMog                     Decimal?  @db.Decimal(8, 4)
  oreMogMese                 Decimal?  @db.Decimal(10, 2)
  oreMogSett                 Decimal?  @db.Decimal(10, 2)
  giaConsolidato             String?
  rischioConsolidamento      String?
  mediaOreSemestre           Decimal?  @db.Decimal(10, 4)
  ventiPctMog                Decimal?  @db.Decimal(10, 4)
  meseProssimoConsolidamento DateTime? @db.Date
  caricatoIl                 DateTime  @default(now())
  caricatoDa                 String?

  @@unique([versione, cf])
  @@index([station])
}

// Aumenti MOG comunicati (PDF / Excel "Aumenti MOG PS" o inseriti a mano)
model MogVariazione {
  id        String   @id @default(cuid())
  cf        String
  nome      String
  pctNuova  Decimal  @db.Decimal(8, 4)
  validaDal DateTime @db.Date
  fonte     String?
  creataIl  DateTime @default(now())

  @@unique([cf, validaDal])
}

// Esito del controllo MOG di fine mese per lavoratore
model MogEsito {
  id                 String   @id @default(cuid())
  mese               String
  station            String
  cf                 String
  nome               String
  oreLav             Decimal  @db.Decimal(10, 2)
  oreAssRetrib       Decimal  @db.Decimal(10, 2)
  computo            Decimal  @db.Decimal(10, 2)
  oreMog             Decimal? @db.Decimal(10, 2)
  gap                Decimal? @db.Decimal(10, 2)
  stato              String
  proiezioneFineMese Decimal? @db.Decimal(10, 2)
  costoIntegrazione  Decimal  @db.Decimal(12, 2)
  creatoIl           DateTime @default(now())

  @@index([mese, station])
}
